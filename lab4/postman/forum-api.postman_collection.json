                  "const page = pm.response.json();",
                  "pm.test(\"Знайдено хоча б одну тему\", () => pm.expect(page.totalElements).to.be.above(0));",
                  "pm.test(\"Кожна назва містить слово spring\", () => page.content.forEach(t => pm.expect(t.title.toLowerCase()).to.include(\"spring\")));"
                ]

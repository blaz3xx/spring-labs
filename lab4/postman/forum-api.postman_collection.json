          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/topics/{{topicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics",
                "{{topicId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",

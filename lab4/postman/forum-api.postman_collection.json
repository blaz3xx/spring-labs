                "999999"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Назва неіснуючої теми\",\n  \"author\": \"Аня\",\n  \"category\": \"OTHER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Відповідь відповідає схемі ProblemDetail\", () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"status\",\"title\",\"detail\"],\"properties\":{\"status\":{\"type\":\"integer\"},\"title\":{\"type\":\"string\"},\"detail\":{\"type\":\"string\"}}}));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Фільтрація і пагінація",
      "item": [
        {
          "name": "Перша сторінка з двох тем",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/topics?page=0&size=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "2"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Відповідь відповідає схемі PageResponse\", () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"content\",\"page\",\"size\",\"totalElements\",\"totalPages\"],\"properties\":{\"content\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"id\",\"title\",\"author\",\"category\",\"createdAt\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"title\":{\"type\":\"string\"},\"author\":{\"type\":\"string\"},\"category\":{\"type\":\"string\",\"enum\":[\"STUDY\",\"GAMES\",\"OTHER\"]},\"createdAt\":{\"type\":\"string\"}}}},\"page\":{\"type\":\"integer\"},\"size\":{\"type\":\"integer\"},\"totalElements\":{\"type\":\"integer\"},\"totalPages\":{\"type\":\"integer\"}}}));",
                  "const page = pm.response.json();",
                  "pm.test(\"На сторінці не більше 2 тем\", () => pm.expect(page.content.length).to.be.at.most(2));",
                  "pm.test(\"Метадані пагінації узгоджені\", () => {",
                  "    pm.expect(page.page).to.eql(0);",
                  "    pm.expect(page.size).to.eql(2);",
                  "    pm.expect(page.totalPages).to.eql(Math.ceil(page.totalElements / 2));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Фільтр за категорією",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/topics?category=STUDY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [

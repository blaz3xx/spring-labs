{
  "info": {
    "name": "Forum REST API — Лабораторна робота №4",
    "description": "Тести RESTful вебсервісу форуму на відповідність документації OpenAPI (/v3/api-docs). Запускайте папки по черзі через Collection Runner: запити використовують змінні topicId і postId, які заповнюються автоматично.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Теми: створення, читання, повне оновлення",
      "item": [
        {
          "name": "Створити тему",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/topics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics"
              ]
            },
            "description": "Очікується 201 Created, заголовок Location і створена тема в тілі.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Тема з Postman\",\n  \"author\": \"Артем\",\n  \"category\": \"STUDY\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Є заголовок Location\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.test(\"Відповідь відповідає схемі TopicResponse\", () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"id\",\"title\",\"author\",\"category\",\"createdAt\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"title\":{\"type\":\"string\"},\"author\":{\"type\":\"string\"},\"category\":{\"type\":\"string\",\"enum\":[\"STUDY\",\"GAMES\",\"OTHER\"]},\"createdAt\":{\"type\":\"string\"}}}));",
                  "const topic = pm.response.json();",
                  "pm.test(\"Location вказує на створену тему\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/topics/\" + topic.id));",
                  "pm.collectionVariables.set(\"topicId\", topic.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Створити тему з некоректними даними",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/topics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics"
              ]
            },
            "description": "Назва закоротка, автор порожній, категорії немає. Очікується 400 і перелік помилок за полями.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"abc\",\n  \"author\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Відповідь відповідає схемі ProblemDetail\", () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"status\",\"title\",\"detail\"],\"properties\":{\"status\":{\"type\":\"integer\"},\"title\":{\"type\":\"string\"},\"detail\":{\"type\":\"string\"}}}));",
                  "const errors = pm.response.json().errors;",
                  "pm.test(\"Є помилки для title, author і category\", () => pm.expect(errors).to.have.all.keys(\"title\", \"author\", \"category\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Отримати тему за id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/topics/{{topicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics",
                "{{topicId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Відповідь відповідає схемі TopicResponse\", () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"id\",\"title\",\"author\",\"category\",\"createdAt\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"title\":{\"type\":\"string\"},\"author\":{\"type\":\"string\"},\"category\":{\"type\":\"string\",\"enum\":[\"STUDY\",\"GAMES\",\"OTHER\"]},\"createdAt\":{\"type\":\"string\"}}}));",
                  "pm.test(\"Повернуто саме ту тему\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"topicId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Отримати неіснуючу тему",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/topics/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",

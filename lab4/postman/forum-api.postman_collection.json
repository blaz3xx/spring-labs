              ],
              "query": [
                {
                  "key": "category",
                  "value": "STUDY"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Усі теми мають категорію STUDY\", () => pm.response.json().content.forEach(t => pm.expect(t.category).to.eql(\"STUDY\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Пошук за частиною назви",

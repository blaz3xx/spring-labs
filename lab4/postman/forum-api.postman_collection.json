    {
      "name": "3. Часткове оновлення (PATCH)",
      "item": [
        {
          "name": "JSON Merge Patch (RFC 7386)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/merge-patch+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/topics/{{topicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics",
                "{{topicId}}"
              ]
            },
            "description": "Змінюється лише title, інші поля лишаються такими, як після PUT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Назва змінена через Merge Patch\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Відповідь відповідає схемі TopicResponse\", () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"id\",\"title\",\"author\",\"category\",\"createdAt\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"title\":{\"type\":\"string\"},\"author\":{\"type\":\"string\"},\"category\":{\"type\":\"string\",\"enum\":[\"STUDY\",\"GAMES\",\"OTHER\"]},\"createdAt\":{\"type\":\"string\"}}}));",
                  "const topic = pm.response.json();",
                  "pm.test(\"Змінено лише назву\", () => {",
                  "    pm.expect(topic.title).to.eql(\"Назва змінена через Merge Patch\");",
                  "    pm.expect(topic.author).to.eql(\"Аня\");",
                  "    pm.expect(topic.category).to.eql(\"GAMES\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "JSON Merge Patch з null для обов'язкового поля",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/merge-patch+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/topics/{{topicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics",
                "{{topicId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Відповідь відповідає схемі ProblemDetail\", () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"status\",\"title\",\"detail\"],\"properties\":{\"status\":{\"type\":\"integer\"},\"title\":{\"type\":\"string\"},\"detail\":{\"type\":\"string\"}}}));",
                  "pm.test(\"Помилка стосується поля category\", () => pm.expect(pm.response.json().errors).to.have.property(\"category\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "JSON Patch (RFC 6902)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json-patch+json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/topics/{{topicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "topics",
                "{{topicId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"op\": \"test\",\n    \"path\": \"/author\",\n    \"value\": \"Аня\"\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/title\",\n    \"value\": \"Назва змінена через JSON Patch\"\n  },\n  {\n    \"op\": \"replace\",\n    \"path\": \"/category\",\n    \"value\": \"OTHER\"\n  }\n]"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Відповідь відповідає схемі TopicResponse\", () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"required\":[\"id\",\"title\",\"author\",\"category\",\"createdAt\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"title\":{\"type\":\"string\"},\"author\":{\"type\":\"string\"},\"category\":{\"type\":\"string\",\"enum\":[\"STUDY\",\"GAMES\",\"OTHER\"]},\"createdAt\":{\"type\":\"string\"}}}));",
                  "const topic = pm.response.json();",
                  "pm.test(\"Операції застосовано\", () => {",
                  "    pm.expect(topic.title).to.eql(\"Назва змінена через JSON Patch\");",
                  "    pm.expect(topic.category).to.eql(\"OTHER\");",
                  "});"
                ]
              }
            }
          ]
        },
